# Copy to .env. Never put keys in NEXT_PUBLIC variables.
# Built-in rules need no setup. Provider status means configured, not connectivity tested.
CLOUD_BASE_URL=https://api.groq.com/openai/v1
CLOUD_API_KEY=
CLOUD_MODEL=
# Example: install/pull a suitable model separately, then set its exact model name.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Optional SQLite location. Default: .data/pipelinemedic.db
PIPELINEMEDIC_DB_PATH=
# Optional gate for all diagnostic/config APIs. Enter in the UI's connection settings.
# Required behind a public-facing reverse proxy; also add TLS, auth and rate limiting there.
PIPELINEMEDIC_ACCESS_TOKEN=
# Only needed behind a reverse proxy: exact external origin, including scheme and port.
PIPELINEMEDIC_ORIGIN=
